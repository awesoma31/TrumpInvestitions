{
  "info": {
    "_postman_id": "8d37bd03-0b14-4f2f-9a15-2f8b61f8a1b7",
    "name": "Market Data Service",
    "description": "Postman collection for market-data-service endpoints from swagger/market-data-service.yml",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "symbol",
      "value": "BTCUSDT"
    },
    {
      "key": "symbols",
      "value": "BTCUSDT,AAPL,MSFT"
    },
    {
      "key": "searchQuery",
      "value": "BTC"
    },
    {
      "key": "limit",
      "value": "50"
    },
    {
      "key": "offset",
      "value": "0"
    },
    {
      "key": "from",
      "value": "2020-01-01T00:00:00Z"
    },
    {
      "key": "to",
      "value": "2035-01-01T00:00:00Z"
    },
    {
      "key": "interval",
      "value": "1m"
    },
    {
      "key": "depth",
      "value": "20"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/system/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system",
                "health"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/system/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system",
                "ready"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Instruments",
      "item": [
        {
          "name": "Search Instruments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?q={{searchQuery}}&limit={{limit}}&offset={{offset}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{searchQuery}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "offset",
                  "value": "{{offset}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Instrument By Symbol",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments/{{symbol}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments",
                "{{symbol}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Quotes",
      "item": [
        {
          "name": "Get Quotes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quotes?symbols={{symbols}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotes"
              ],
              "query": [
                {
                  "key": "symbols",
                  "value": "{{symbols}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Quote By Symbol",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quotes/{{symbol}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotes",
                "{{symbol}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "History",
      "item": [
        {
          "name": "Get Candle History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/history/candles?symbol={{symbol}}&from={{from}}&to={{to}}&interval={{interval}}&limit={{limit}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "history",
                "candles"
              ],
              "query": [
                {
                  "key": "symbol",
                  "value": "{{symbol}}"
                },
                {
                  "key": "from",
                  "value": "{{from}}"
                },
                {
                  "key": "to",
                  "value": "{{to}}"
                },
                {
                  "key": "interval",
                  "value": "{{interval}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Order Book",
      "item": [
        {
          "name": "Get Order Book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/order-book/{{symbol}}?depth={{depth}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order-book",
                "{{symbol}}"
              ],
              "query": [
                {
                  "key": "depth",
                  "value": "{{depth}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
