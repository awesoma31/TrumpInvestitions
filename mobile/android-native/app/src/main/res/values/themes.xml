        <item name="colorSurfaceVariant">@color/trading_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/trading_on_surface_variant</item>
        <item name="colorOutline">@color/trading_outline</item>
        <item name="colorOutlineVariant">@color/trading_outline_variant</item>
        <item name="colorSurfaceInverse">@color/trading_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/trading_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/trading_inverse_primary</item>
    </style>
</resources>