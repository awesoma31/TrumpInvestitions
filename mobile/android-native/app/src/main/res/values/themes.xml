<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TrumpInvestitions" parent="Theme.Material3.DayNight">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/trading_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/trading_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/trading_on_primary_container</item>
        <item name="colorSecondary">@color/trading_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/trading_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/trading_on_secondary_container</item>
        <item name="colorTertiary">@color/trading_tertiary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/trading_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/trading_on_tertiary_container</item>
        <item name="colorError">@color/red_negative</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/red_error_container</item>
        <item name="colorOnErrorContainer">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnBackground">@color/trading_on_background</item>
        <item name="colorSurface">@color/white</item>
